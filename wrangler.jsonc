{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app-install",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "73d1fa8a-8c4a-4cde-a2cb-d76fc5666595","database_name": "web-app-install" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "b1ca6e45054f4926a589ef5d6f3f20dc" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
